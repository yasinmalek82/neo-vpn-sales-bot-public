# ============================================================
# Bot Configuration
# ============================================================
BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Optional: bot username without @ (falls back to getMe at runtime)
BOT_USERNAME=
# Admin Telegram user IDs: comma-separated (1,2), a single id, or a JSON list ([1,2])
ADMIN_TELEGRAM_IDS=123456789,987654321
# Explicit store catalog owners (Telegram IDs). Do NOT auto-derive from admins.
STORE_OWNER_TELEGRAM_IDS=
# Run mode: polling | webhook
RUN_MODE=polling
# Installer uses false to preserve queued updates when switching from webhook.
POLLING_DROP_PENDING_UPDATES=true
# Webhook settings (only used when RUN_MODE=webhook)
WEBHOOK_HOST=
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook
# Required non-empty when RUN_MODE=webhook (verified by SimpleRequestHandler)
WEBHOOK_SECRET=

# ============================================================
# Database
# ============================================================
# SQLite for local smoke only. Production MUST use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Production / Docker compose example:
# Compose/prod: set strong credentials via env — do not reuse sample passwords.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db:5432/DBNAME
# Local-dev compose override may use bot_pass_local_dev_only (see docker-compose.override.yml.example).

# ============================================================
# PasarGuard Panel API
# ============================================================
# Optional when set in Telegram admin «تنظیمات پنل» (DB overrides env).
PASARGUARD_BASE_URL=https://panel.example.com
# Required for panel connection: API key (pg_key_… UUID). Password auth removed.
# Create in panel UI / POST /api/api_key (needs existing admin); paste raw key here or in Telegram.
PASARGUARD_API_KEY=
# Subscription path on panel (default: "sub")
PASARGUARD_SUB_PATH=sub
# Optional: panel request timeout (seconds)
PASARGUARD_TIMEOUT=30
# Default panel group IDs when a Plan has empty group_ids (comma-separated).
# Empty means none from env; in-bot «تنظیمات پنل» default_group_ids still apply at provision.
# Example: DEFAULT_PANEL_GROUP_IDS=5
DEFAULT_PANEL_GROUP_IDS=

# ============================================================
# Business Logic
# ============================================================
# Order expiry minutes (unpaid orders auto-cancel)
ORDER_EXPIRY_MINUTES=30
# Wallet: credit order.price_toman on first PROVISION_FAILED after payment (N=1)
WALLET_PROVISION_FAIL_CREDIT_MAX_N=1
# Referral reward: percent discount for referrer
REFERRAL_DISCOUNT_PERCENT=10
# Referral reward for referred user (percent)
REFERRAL_REFERRED_DISCOUNT_PERCENT=5
# Max total discount percent (referral + promo)
MAX_DISCOUNT_PERCENT=50
# Default data limit reset strategy for plans (no_reset|day|week|month|year)
DEFAULT_RESET_STRATEGY=no_reset
# Path to dynamic pricing JSON (volume/unlimited tiers & discounts)
PRICING_CONFIG_PATH=config/pricing.json

# Free trial
TRIAL_ENABLED=true
TRIAL_DATA_LIMIT_GB=5
TRIAL_DURATION_DAYS=1
TRIAL_HWID_LIMIT=1


# ============================================================
# Card-to-card payment (shown to customers)
# ============================================================
PAYMENT_CARD_NUMBER=6037-XXXX-XXXX-XXXX
PAYMENT_CARD_HOLDER_NAME=Example Holder
PAYMENT_BANK_NAME=
PAYMENT_INSTRUCTIONS=

# Blu SMS receiver: off until an owner configures an iPhone automation.
BANK_SMS_ENABLED=false
BANK_SMS_TOKEN=
BANK_SMS_SENDER=BLUE
# Keep this stable for the same underlying account, even after card replacement.
BANK_SMS_ACCOUNT_KEY=blu-main
BANK_SMS_URL=

# ============================================================
# Scheduler / Jobs
# ============================================================
# Enable APScheduler jobs
SCHEDULER_ENABLED=true
# Expire unpaid orders check interval
EXPIRE_ORDERS_INTERVAL_MINUTES=5
# Renewal reminders: days before expiry to notify (comma-separated)
RENEWAL_REMINDER_DAYS=3,1
# Service detail: show expiring-soon badge / renew CTA within N days
SERVICE_EXPIRE_WARN_DAYS=7
DISPLAY_TIMEZONE=Asia/Tehran
# Panel/node watcher: seconds between checks of PasarGuard (0 = off). An alert needs
# two checks in a row, so a dead node is reported after about two intervals.
PANEL_WATCH_INTERVAL_SECONDS=120
# Cleanup old logs (days)
# Days to keep delivered reports and finished broadcast recipients.
CLEANUP_LOGS_DAYS=90

# ============================================================
# Logging / Debug
# ============================================================
LOG_LEVEL=INFO
DEBUG=false

# ============================================================
# Sentry (optional)
# ============================================================
# Leave empty to disable. Set a project DSN to enable error reporting.
SENTRY_DSN=
# Optional: environment tag (e.g. production, staging, local)
SENTRY_ENVIRONMENT=
# Optional: traces sample rate 0.0–1.0 (default 0.0 = off)
SENTRY_TRACES_SAMPLE_RATE=0.0

# ============================================================
# Button colours (Bot API 9.4). Blue = the one main action, green = approve,
# red = destructive. Set false to render every button plain.
BUTTON_COLORS_ENABLED=true

# Telegram Mini App panel («پنل وب» on the admin home). Off by default: with
# false no route is mounted and no button is shown. When true, WEB_PANEL_URL
# must be the public https address of the shell page (it ends in /panel/);
# the bot refuses to start otherwise. Polling mode then also listens on
# WEBHOOK_PORT for the panel. For TLS, see docker-compose `--profile panel`
# (needs WEB_PANEL_DOMAIN in the shell or in docker/.env).
WEB_PANEL_ENABLED=false
WEB_PANEL_URL=
# Second switch, off by default. Off: the personal pages (/panel/me/...: a
# customer's services and wallet, a reseller's dashboard) open for admins only.
# On: any Telegram user who has used the bot and is not banned may open them,
# and only their own data is shown. Nothing in the bot links to them yet.
WEB_PANEL_PUBLIC_ENABLED=false
# WEB_PANEL_DOMAIN=panel.example.com

# Backup Configuration
# ============================================================
# Enable backup cron job
BACKUP_ENABLED=true
# Backup schedule (cron expression) - daily at 03:00
BACKUP_CRON=0 3 * * *
# Retention: keep daily backups for N days
BACKUP_RETAIN_DAILY=7
# Retention: keep weekly backups for N weeks
BACKUP_RETAIN_WEEKLY=4
# Backup directory (mounted volume)
BACKUP_DIR=backups
# PasarGuard panel database URL for backup (separate from bot DB)
# PASARGUARD_DB_URL=postgresql://user:pass@panel-db:5432/pasarguard

# Brand contact points (public — not secrets). Used by services/brand.py.
# Empty is allowed: copy that needs them drops the line instead of printing «@».
SUPPORT_HANDLE=@neo_network_support
SUPPORT_HOURS_FA=۹ صبح تا ۱۲ شب
CHANNEL_HANDLE=@neo_network_channel
